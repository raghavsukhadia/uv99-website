{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/uv99-plus-one-qr.html", "destination": "/pages/uv99-plus-one-qr.html" },
    { "source": "/:seg(uv99\\+1|uv99%2B1|uv99-plus-one|uv99plus1)/:qr([Qq][Rr])/", "destination": "/pages/uv99-plus-one-qr.html" },
    { "source": "/:seg(uv99\\+1|uv99%2B1|uv99-plus-one|uv99plus1)/:qr([Qq][Rr])", "destination": "/pages/uv99-plus-one-qr.html" },
    { "source": "/:seg(uv99\\+1|uv99%2B1|uv99-plus-one|uv99plus1)/:qr([Qq][Rr])/:lang(hindi|marathi|kannada|odia|telugu|tamil|malayalam)", "destination": "/pages/uv99-plus-one-qr.html" },
    { "source": "/:seg(uv99\\+1|uv99%2B1|uv99-plus-one|uv99plus1)/:qr([Qq][Rr])/:lang(hindi|marathi|kannada|odia|telugu|tamil|malayalam)/", "destination": "/pages/uv99-plus-one-qr.html" },
    { "source": "/QR", "destination": "/pages/qr.html" },
    { "source": "/QR/", "destination": "/pages/qr.html" },
    { "source": "/qr", "destination": "/pages/qr.html" },
    { "source": "/qr/", "destination": "/pages/qr.html" },
    { "source": "/QR/:lang(hindi|kannada|odia|telugu|tamil|malayalam)", "destination": "/pages/qr-:lang.html" },
    { "source": "/QR/:lang(hindi|kannada|odia|telugu|tamil|malayalam)/", "destination": "/pages/qr-:lang.html" },
    { "source": "/QR/:x([Hh][Ii][Nn][Dd][Ii])", "destination": "/pages/qr-hindi.html" },
    { "source": "/QR/:x([Kk][Aa][Nn][Nn][Aa][Dd][Aa])", "destination": "/pages/qr-kannada.html" },
    { "source": "/QR/:x([Oo][Dd][Ii][Aa])", "destination": "/pages/qr-odia.html" },
    { "source": "/QR/:x([Tt][Ee][Ll][Uu][Gg][Uu])", "destination": "/pages/qr-telugu.html" },
    { "source": "/QR/:x([Tt][Aa][Mm][Ii][Ll])", "destination": "/pages/qr-tamil.html" },
    { "source": "/QR/:x([Mm][Aa][Ll][Aa][Yy][Aa][Ll][Aa][Mm])", "destination": "/pages/qr-malayalam.html" },
    { "source": "/QR/:x([Hh][Ii][Nn][Dd][Ii])/", "destination": "/pages/qr-hindi.html" },
    { "source": "/QR/:x([Kk][Aa][Nn][Nn][Aa][Dd][Aa])/", "destination": "/pages/qr-kannada.html" },
    { "source": "/QR/:x([Oo][Dd][Ii][Aa])/", "destination": "/pages/qr-odia.html" },
    { "source": "/QR/:x([Tt][Ee][Ll][Uu][Gg][Uu])/", "destination": "/pages/qr-telugu.html" },
    { "source": "/QR/:x([Tt][Aa][Mm][Ii][Ll])/", "destination": "/pages/qr-tamil.html" },
    { "source": "/QR/:x([Mm][Aa][Ll][Aa][Yy][Aa][Ll][Aa][Mm])/", "destination": "/pages/qr-malayalam.html" },
    { "source": "/QR/:path*", "destination": "/pages/qr.html" },
    { "source": "/about.html", "destination": "/pages/about.html" },
    { "source": "/disclaimer.html", "destination": "/pages/disclaimer.html" },
    { "source": "/faq-contact.html", "destination": "/pages/faq-contact.html" },
    { "source": "/films.html", "destination": "/pages/films.html" },
    { "source": "/hero-uv99.html", "destination": "/pages/hero-uv99.html" },
    { "source": "/privacy.html", "destination": "/pages/privacy.html" },
    { "source": "/qr.html", "destination": "/pages/qr.html" },
    { "source": "/series-showcase.html", "destination": "/pages/series-showcase.html" },
    { "source": "/terms.html", "destination": "/pages/terms.html" },
    { "source": "/uv99-plus-one.html", "destination": "/pages/uv99-plus-one.html" },
    { "source": "/warranty.html", "destination": "/pages/warranty.html" },
    { "source": "/_probe.html", "destination": "/pages/_probe.html" }
  ]
}
