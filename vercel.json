{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/QR", "destination": "/qr.html" },
    { "source": "/QR/", "destination": "/qr.html" },
    { "source": "/QR/:path*", "destination": "/:path*" }
  ]
}
